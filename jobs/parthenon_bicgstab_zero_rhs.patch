+  // a / b, or 0 if b == 0. An exactly zero residual (e.g. a zero right-hand side and a
+  // zero initial guess) makes the scalars of the first iteration 0 / 0. Taking them as 0
+  // leaves x unchanged and lets the residual check end the solve, instead of returning
+  // NaN after max_iters iterations.
+  static Real SafeDiv(const Real a, const Real b) { return b == 0.0 ? 0.0 : a / b; }
