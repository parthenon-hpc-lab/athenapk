<comment>
problem   = Supersonic turbulence, purely solenoidal forcing, near isothermal
reference = https://github.com/parthenon-hpc-lab/athenapk/blob/main/docs/turbulence.md

<job>
problem_id = turbulence

<parthenon/output1>
file_type  = hst        # History data dump
dt         = 0.005      # time increment between outputs

<parthenon/output2>
file_type  = hdf5       # gas snapshots (disabled during gas-only phase)
variables  = prim
dt         = -1
id         = prim

<parthenon/output3>
file_type  = rst        # Binary data dump
dt         = 0.1        # time increment between outputs
id         = restart

<parthenon/time>
cfl = 0.3               # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 100000     # cycle limit
tlim       = 1.0        # time limit
integrator  = vl2       # time integration algorithm
ncycle_out_mesh = -500  # print mesh structure every 500 cyles and on refinement

<parthenon/mesh>
nghost     = 2
nx1        = 64
x1min      = 0.0        # minimum value of X1
x1max      = 1.0        # maximum value of X1
ix1_bc     = periodic   # inner-X1 boundary flag
ox1_bc     = periodic   # outer-X1 boundary flag

nx2        = 64
x2min      = 0.0        # minimum value of X2
x2max      = 1.0        # maximum value of X2
ix2_bc     = periodic   # inner-X2 boundary flag
ox2_bc     = periodic   # outer-X2 boundary flag

nx3        = 64
x3min      = 0.0        # minimum value of X3
x3max      = 1.0        # maximum value of X3
ix3_bc     = periodic   # inner-X3 boundary flag
ox3_bc     = periodic   # outer-X3 boundary flag

packs_per_rank = 1      # pack all blocks in a single pack (currently required)

<parthenon/meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
fluid = euler
eos = adiabatic
riemann = hllc
reconstruction = plm
gamma           = 1.0001         # gamma = C_p/C_v
first_order_flux_correct = true  # fall back to first order fluxes if a cell would get rho<0 or p<0
dfloor = 1.0e-8
pfloor = 1.0e-8

<tracers>
enabled = false          # enabled on restart (phase 2)

<problem/turbulence>
rho0         = 1.0      # initial mean density
p0           = 1.0      # initial mean pressure
b0           = 0.01     # initial magnetic field (x-direction)
b_config     = 0        # 0 - net flux; 1 - no net flux uniform B; 2 - non net flux sin B; 4 - field loop
kpeak        = 2.0      # characteristic wavenumber
corr_time    = 0.1      # autocorrelation time of the OU forcing process (~T_L)
rseed        = 20190729 # random seed of the OU forcing process
sol_weight   = 1.0      # purely solenoidal forcing
accel_rms    = 40.0     # root mean square value of the acceleration field (M ~ 5)
num_modes    = 20       # number of wavemodes

<modes>
k_1_0	= +2
k_1_1	= -1
k_1_2	= +0
k_2_0	= +1
k_2_1	= +0
k_2_2	= +2
k_3_0	= +1
k_3_1	= +1
k_3_2	= -1
k_4_0	= +2
k_4_1	= +0
k_4_2	= +1
k_5_0	= +0
k_5_1	= +0
k_5_2	= -1
k_6_0	= +1
k_6_1	= -1
k_6_2	= -2
k_7_0	= +1
k_7_1	= +2
k_7_2	= -1
k_8_0	= +1
k_8_1	= +0
k_8_2	= -1
k_9_0	= +0
k_9_1	= +2
k_9_2	= +1
k_10_0	= +0
k_10_1	= -1
k_10_2	= +2
k_11_0	= +0
k_11_1	= +0
k_11_2	= +2
k_12_0	= +0
k_12_1	= +2
k_12_2	= -1
k_13_0	= +2
k_13_1	= +1
k_13_2	= +1
k_14_0	= +1
k_14_1	= -1
k_14_2	= +0
k_15_0	= +1
k_15_1	= +1
k_15_2	= +2
k_16_0	= +1
k_16_1	= +0
k_16_2	= +1
k_17_0	= +0
k_17_1	= -1
k_17_2	= +1
k_18_0	= +0
k_18_1	= +1
k_18_2	= +0
k_19_0	= +1
k_19_1	= -1
k_19_2	= +1
k_20_0	= +2
k_20_1	= +1
k_20_2	= -1
