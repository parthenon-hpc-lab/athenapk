<comment>
problem = One 1e7 Msun star at rest near the corner shared by the root meshblocks,
          with stochastic SN II and SN Ia at their natural rates over 200 Myr, in
          dense gas and with a negligible energy per event, so the gas stays quiet.
          Used by the sn_rates regression test, which compares the events of every
          cycle (from the history output) with the model rates, then restarts the run
          from its 100 Myr dump.

<job>
problem_id = star_formation

<parthenon/output0>
file_type = hst
dn        = 1
id        = hist

<parthenon/output1>
file_type = rst
dt        = 100000.0  # kyr: t = 0, 100 Myr and the final state
id        = restart

<parthenon/time>
cfl        = 0.3
integrator = vl2
tlim       = 200000.0  # kyr
dt_force   = 1000.0    # kyr: fixed 1 Myr steps, so cycle k draws for ages [t_k - dt, t_k]

<parthenon/mesh>
refinement = none
nghost     = 4

nx1    = 32
x1min  = -1600.0
x1max  = 1600.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 32
x2min  = -1600.0
x2max  = 1600.0
ix2_bc = periodic
ox2_bc = periodic

nx3    = 32
x3min  = -1600.0
x3max  = 1600.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<units>
code_length_cgs = 3.0856775809623245e+18
code_mass_cgs   = 1.98841586e+33
code_time_cgs   = 3.15576e+10

<hydro>
fluid            = euler
eos              = adiabatic
riemann          = hllc
reconstruction   = plm
gamma            = 1.6666666666666667
He_mass_fraction = 0.25
Tfloor           = 10.0

<stars>
enabled                   = true
sf_density_threshold      = 1.0e30  # no star formation
transport_mode            = none
seed_stars                = true
SN_II_enabled             = true
SN_Ia_enabled             = true
E_SN_per_event            = 1.0e40  # erg: keeps the gas quiet; events are counted from the history
SN_injection_radius_cells = 2

<problem/star_formation>
ic_mode   = uniform
rho_bg    = 3.30     # Msun/pc^3, n_H = 100 cm^-3 for X = 0.75
T_bg      = 1.0e4    # K
star_x    = -30.0    # pc, in the cell at the corner of the eight meshblocks
star_y    = 20.0
star_z    = -10.0
star_mass = 1.0e7    # Msun: ~1e5 SN II and ~5e3 SN Ia over the run
