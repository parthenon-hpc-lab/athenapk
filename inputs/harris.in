<comment>
problem = Uniform-density Harris current sheet

<job>
problem_id = harris

<problem/harris>
B0               = 1.0       # Asymptotic reconnecting magnetic field
delta            = 0.1       # Current-sheet half-thickness
beta             = 1.0       # Asymptotic plasma beta
rho0             = 1.0       # Asymptotic density
pressure_balance = true      # false selects force balance with a balancing Bz
psi0             = 0.1       # Magnetic perturbation amplitude; set to 0 for equilibrium
lx               = 2.0       # Perturbation wavelength in x1
ly               = 2.0       # Perturbation wavelength in x2

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 128
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 128
x2min = -1.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.4
tlim = 0.5
nlim = 100000

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667
first_order_flux_correct = true

<parthenon/output0>
file_type = hdf5
dt = 0.05
id = prim
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.05
