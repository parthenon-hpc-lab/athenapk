################################################################################
# Smoke test for jet_feedback_mode = weinberger (hydro/euler, fixed_power only,
# no gravity/no accretion triggering -- just enough to exercise the
# reservoir/reduction/injection task-graph pipeline end to end).
################################################################################
<comment>
problem   = Weinberger Jet Feedback Smoke Test

<job>
problem_id = cluster

<parthenon/output1>
file_type  = hst
dt         = 1e-4

<parthenon/time>
cfl        = 0.3
nlim       = 60
tlim       = 1.0
integrator = vl2

<parthenon/mesh>
refinement = none
nghost = 2

nx1        = 32
x1min      = -0.1
x1max      = 0.1
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 32
x2min      = -0.1
x2max      = 0.1
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 32
x3min      = -0.1
x3max      = 0.1
ix3_bc     = outflow
ox3_bc     = outflow

<parthenon/meshblock>
nx1        = 16
nx2        = 16
nx3        = 16

<hydro>
fluid = euler
gamma = 1.6666666666666667
eos = adiabatic
riemann = hllc
reconstruction = dc
calc_dt_hyp = true
scratch_level = 0
first_order_flux_correct = true
dfloor = 1e-6
pfloor = 1e-8

He_mass_fraction = 0.25

<units>
code_length_cgs = 3.085677580962325e+24 # 1 Mpc in cm
code_mass_cgs = 1.98841586e+47          # 1e14 Msun in g
code_time_cgs = 3.15576e+16             # 1 Gyr in s

<problem/cluster>

<problem/cluster/gravity>
gravity_srcterm = false
# m_smbh left at its C++ default (3.4e8 Msun, converted to code units) --
# an earlier version of this file set "m_smbh = 3.4e8" here, which is taken
# as a *code-unit* value (not Msun) since it's given explicitly rather than
# defaulted, i.e. 3.4e8 * 1e14 Msun = 3.4e22 Msun -- ~10^8x too large. Caught
# via the "[Weinberger][init] m_smbh_initial = ... Msun" diagnostic print.

<problem/cluster/uniform_gas>
init_uniform_gas = true
rho = 147.7557589278723
ux = 0
uy = 0
uz = 0
pres = 1.5454368403867562

<problem/cluster/agn_triggering>
triggering_mode = NONE
accretion_radius = 0.06

<problem/cluster/agn_feedback>
jet_feedback_mode = weinberger
# fixed_power = 1.0e2 was wildly too large for this coarse (R_jet resolved by
# ~3 cells) test box: it drove a peak per-cell kick of ~41c at the cell
# nearest the BH (the cubic-spline kernel W17 Eq. 4/15 uses for the momentum
# weighting is centrally *peaked*, so with only a few cells spanning R_jet,
# the central cell captures a hugely disproportionate share of the kick --
# this is a resolution requirement W17/W23 discuss at length, not a bug in
# the reservoir/momentum-solve bookkeeping, which checked out exactly
# (mass and reservoir-energy audits both balanced to the last digit). Dropped
# by ~5 orders of magnitude to stay comfortably sub-relativistic at this
# resolution for the smoke test.
fixed_power = 5.0e-4
efficiency = 1e-3

thermal_fraction = 0.0
kinetic_fraction = 1.0

# weinberger_jet_density left at its C++ default (1e-28 g/cm^3, converted to
# code units) -- setting it here would need a code-unit value, not cgs.
enable_tracer = false

<problem/cluster/snia_feedback>
disabled = True
