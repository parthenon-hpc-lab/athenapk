################################################################################
# Test for jet_feedback_mode = weinberger driven by AGNTriggeringMode::
# BOOSTED_BONDI instead of fixed_power: a real hydrostatic-equilibrium
# cluster atmosphere (NFW halo + Hernquist BCG + SMBH point mass,
# entropy-profile parameters taken from the existing inputs/cluster/cluster.in
# "typical cluster" example -- itself an ACCEPT-like/Perseus-like fit) feeds
# AGNTriggering's Bondi accretion-rate estimate directly from the ambient gas
# near the BH, so mass/energy for the jet are actually extracted from that
# region rather than conjured from a fixed_power knob. (An earlier version of
# this file used AGNTriggeringMode::COLD_GAS with single-cell cold clumps --
# see cold_clumps.hpp and the disabled problem/cluster/cold_clumps block below
# -- but the clumps got shock-heated during infall and never satisfied the
# temperature criterion; Bondi sidesteps that since it has no temperature
# threshold.) This also exercises WeinbergerResyncSMBHMassAndGravity's
# SMBH-mass -> gravity feedback: as the jet-launch region drains mass (Sec
# 2.5/2.8), the point-mass term in the potential should visibly grow.
################################################################################
<comment>
problem   = Weinberger Jet Feedback / Bondi Triggering / Gravity Test

<job>
problem_id = cluster

<parthenon/output1>
file_type  = hst
dt         = 1e-4

<parthenon/output2>
file_type  = rst       # restart data dump
dt         = 0.01      # 10 Myr (code_time_cgs = 1 Gyr, so 0.01 code time units)
id         = restart

<parthenon/time>
cfl        = 0.3
nlim       = -1
tlim       = 2.0
integrator = vl2

<parthenon/mesh>
refinement = none
nghost = 2

nx1        = 32
x1min      = -0.1
x1max      = 0.1
ix1_bc     = periodic
ox1_bc     = periodic

nx2        = 32
x2min      = -0.1
x2max      = 0.1
ix2_bc     = periodic
ox2_bc     = periodic

nx3        = 32
x3min      = -0.1
x3max      = 0.1
ix3_bc     = periodic
ox3_bc     = periodic

<parthenon/meshblock>
nx1        = 16
nx2        = 16
nx3        = 16

<hydro>
fluid = euler
gamma = 1.6666666666666667
eos = adiabatic
riemann = hllc
reconstruction = dc
calc_dt_hyp = true
scratch_level = 0
first_order_flux_correct = true
dfloor = 1e-6
pfloor = 1e-8

He_mass_fraction = 0.25

<units>
code_length_cgs = 3.085677580962325e+24 # 1 Mpc in cm
code_mass_cgs = 1.98841586e+47          # 1e14 Msun in g
code_time_cgs = 3.15576e+16             # 1 Gyr in s

<cooling>
enable_cooling   = tabular
table_filename   = schure.cooling_1.0Z
lambda_units_cgs = 1.0 # 1.00e+00 cm**3*erg/s
integrator       = townsend
cfl              = 0.0
# log_temp_col/log_lambda_col intentionally omitted: TabularCooling now only
# supports single-metallicity tables with a fixed log10(T), log10(lambda)
# layout and warns (PARTHENON_WARN) that these two are deprecated if present
# -- tabular_cooling.cpp:39-46. schure.cooling_1.0Z already has that layout
# (also present in this repo at inputs/cooling_tables/schure.cooling_1.0Z, in
# case that's a more convenient path than wherever you placed your own copy).
# table_filename is opened as a literal path (IOWrapper::Open, tabular_cooling
# .cpp:76) at whatever the binary's cwd is when it runs -- no lookup directory
# -- so this only resolves if you run from a directory containing (or
# symlinking) schure.cooling_1.0Z, e.g. the light-jet/ dir you mentioned
# adding it to.

<problem/cluster>
hubble_parameter = 0.0715898515654728

<problem/cluster/gravity>
gravity_srcterm = true

include_nfw_g = True
which_bcg_g = HERNQUIST
include_smbh_g = True

# NFW parameters (M200,c = 1e15 Msun, c_nfw = 6.0 -- same "typical massive
# cluster" values as inputs/cluster/cluster.in)
c_nfw = 6.0
m_nfw_200 = 10.0

# BCG parameters (same as cluster.in)
m_bcg_s = 0.001
r_bcg_s = 0.004

# SMBH initial mass (3.4e8 Msun in code units; this is the C++ default too,
# spelled out here as a reminder that it's code units, not Msun -- see
# weinberger_smoke_test.in for the unit trap this avoids)
m_smbh = 3.4e-06

g_smoothing_radius = 0.0

<problem/cluster/entropy_profile>
# Same ACCEPT-like entropy profile parameters as cluster.in (r_k = 0.1 Mpc
# happens to match this test's domain edge).
k_0 = 8.851337676479303e-121
k_100 = 1.3277006514718954e-119
r_k = 0.1
alpha_k = 1.1

<problem/cluster/hydrostatic_equilibrium>
r_fix = 2.0
rho_fix = 0.01477557589278723
r_sampling = 4.0

<problem/cluster/cold_clumps>
# Disabled again: instead of forcing clumps in by hand, let a real cooling
# flow develop self-consistently from the hydrostatic atmosphere (periodic
# BCs + initial turbulent velocity perturbation + cooling, see
# init_perturb/cooling blocks) and watch for the first thermally-unstable cold
# gas to condense out on its own before worrying about triggering again.
enable = false
n_clumps_per_block = 2
temperature = 1e4
min_radius = 0.07
max_radius = 0.09
rng_seed = 42

<problem/cluster/init_perturb>
# Initial turbulent velocity field, Kolmogorov-like via a few-mode Fourier
# perturbation (utils/few_modes_ft.hpp) -- same rms velocity (75 km/s) as
# Weinberger+2023 Sec 2.1's own self-regulated cluster ICs, converted to code
# units (1 code velocity unit = code_length_cgs/code_time_cgs = 1 Mpc/Gyr =
# 977.79 km/s): 75/977.79 = 0.07671.
sigma_v    = 0.07671
l_peak_v   = 0.05      # 50 kpc driving scale (1/4 of this box's 200 kpc side)
num_modes_v = 40
rseed_v    = 1

<problem/cluster/agn_triggering>
triggering_mode = COLD_GAS
# Back to 60 kpc (R_jet = 20 kpc, ~3.2 grid cells at this grid's 6.25 kpc
# spacing) -- 25 kpc (R_jet = 8.3 kpc, ~1.3 cells) let the cubic-spline
# kernel's peak value get large enough that even a modest, well-balanced
# trigger produced a ~4.6c peak per-cell kick, which is what actually seeded
# the dt/T runaway (the accretion_inner_radius shell-exclusion fix didn't
# stop it because the resulting wreckage propagated outside R_jet within one
# step anyway).
accretion_radius = 0.06
cold_temp_thresh = 100000.0
cold_t_acc       = 0.01

<problem/cluster/agn_feedback>
jet_feedback_mode = weinberger
# fixed_power intentionally left at its default (0) -- all jet power should
# come from AGNTriggering's cold-gas accretion rate now.
efficiency = 1e-3

thermal_fraction = 0.0
kinetic_fraction = 1.0

# weinberger_jet_density left at its C++ default (1e-28 g/cm^3, converted to
# code units).
enable_tracer = false

<problem/cluster/snia_feedback>
disabled = True
