#<comment>
#problem = Keplerian disk in cylindrical coordinates

<job>
problem_id = disk

<parthenon/mesh>
refinement = none
nghost = 2

# R
nx1 = 64
x1min = 0.5
x1max = 2.0
ix1_bc = user
ox1_bc = user

# z
nx2 = 256
x2min = -0.5
x2max = 0.5
ix2_bc = user
ox2_bc = user

# phi
nx3 = 1
x3min = 0.0
x3max = 6.2831853071795862
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 64
nx2 = 256
nx3 = 1

<parthenon/output0>
file_type = hdf5
dt          = 0.01
variables = prim
id = prim
use_final_label = false

<parthenon/output1>
file_type = hst
dt          = 0.628    # time increment between outputs
use_final_label = false

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 628.

<hydro>
fluid = euler
eos = adiabatic
riemann = hlle
reconstruction = plm
first_order_flux_correct = true
gamma           = 1.66666667 # gamma = C_p/C_v

<problem/disk>
GM          = 1.0
r0          = 1.0
rho0        = 1.0
p0_over_rho0  = 0.01
pslope      = -0.5
dslope      = -2.25
