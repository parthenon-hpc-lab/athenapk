# This file was made in part with generative AI
# See docs/constrained_transport.md for solver choices and refinement details.
# Waves: scale nx1=2*N, nx2=N (and nx3=N in 3D); scale blocks consistently.
# For MPI, use no more ranks than the available leaf MeshBlocks.
# AthenaPK - a performance portable block structured AMR MHD code
# Copyright (c) 2021, Athena Parthenon Collaboration. All rights reserved.
# Licensed under the BSD 3-Clause License (the "LICENSE");

<comment>
problem = cpaw (second-order CT-compatible example)
reference = G. Toth. JCP, vol. 161, pp. 605-662 (2000).

<job>
problem_id = cpaw

<problem/cpaw>
compute_error = true  # set value to one to compute L1 error compared to initial data
b_par   = 1.0         # B parallel
b_perp  = 0.1         # B perpendicular
pres    = 0.1         # pressure
v_par   = 1.0         # vpar = 1 with dir=1 is traveling
dir     = 1           # 1: right polarization 2: left
ang_2 = 0.0

ang_3 = -999.9

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 64
x1min = 0.0
x1max = 3.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = 0.0
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = 0.0
x3max = 1.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1=16
nx2=16
nx3=1

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 1.0
nlim = 100000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = ucthlldmhd
eos = adiabatic
reconstruction = plm
riemann = hlld
gamma = 1.666666666666667
scratch_level = 1

ct_energy_correction = false
first_order_flux_correct = false

<parthenon/output0>
file_type = hdf5
dt = -0.01
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.01

<parthenon/job>
problem_id = cpaw
