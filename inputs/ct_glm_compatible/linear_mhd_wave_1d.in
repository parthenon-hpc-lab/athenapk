# This file was made in part with generative AI
# See docs/constrained_transport.md for solver choices and refinement details.
# Waves: scale nx1=2*N, nx2=N (and nx3=N in 3D); scale blocks consistently.
# For MPI, use no more ranks than the available leaf MeshBlocks.
# AthenaPK - a performance portable block structured AMR MHD code
# Copyright (c) 2020, Athena Parthenon Collaboration. All rights reserved.
# Licensed under the BSD 3-Clause License (the "LICENSE");

<comment>
problem = linear_mhd_wave_1d (second-order CT-compatible example)

<parthenon/job>
problem_id = linear_mhd_wave_1d

<job>
problem_id = linear_wave_mhd

<problem/linear_wave_mhd>
compute_error = true  # when 'true' outputs L1 error compared to initial data
wave_flag = 0         # Wave family number (0 - 6 for mhd)
amp       = 1.0e-6    # Wave Amplitude
vflow     = 0.0       # background flow velocity
test      = true
ang_2 = 0.0

ang_3 = 0.0

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 64
x1min = 0.0
x1max = 3.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 1
x2min = 0.0
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = 0.0
x3max = 1.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 1.0
nlim = 100000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = ucthlldmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667
scratch_level = 1

ct_energy_correction = false
first_order_flux_correct = false

<parthenon/output0>
file_type = hdf5
dt = -0.01
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.05
