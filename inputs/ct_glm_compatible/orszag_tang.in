<comment>
problem = orszag_tang (second-order CT-compatible example)

<parthenon/job>
problem_id = orszag_tang

<job>
problem_id = orszag_tang

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 256
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 256
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 256
nx2 = 256
nx3 = 1

<parthenon/time>
integrator = rk2
cfl = 0.3
tlim = 1.0
nlim = -1
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = ucthlldmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667
pfloor = 1.0e-15
scratch_level = 1


ct_energy_correction = false
first_order_flux_correct = false

<parthenon/output0>
file_type = hdf5
dt = 0.01
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.02
